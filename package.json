{
  "name": "myvoicemaker",
  "version": "0.1.1",
  "description": "Official JavaScript/TypeScript SDK for the VoiceMaker API",
  "author": "Collins Edim",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "voicemaker",
    "tts",
    "asr",
    "speech",
    "transcription",
    "nigerian-languages",
    "yoruba",
    "igbo",
    "hausa",
    "pidgin",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Equalyz-AI/myvoicemaker-js"
  }
}
